# Python-generated files
__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
wheels/
*.egg-info

# Project-local package manager caches
.uv-cache/

# Virtual environments
.venv

# Downloaded datasets stay local; they are reproducible from the download scripts.
data/**/*
!data/**/
!data/**/.gitkeep

# Benchmark predictions, reports, figures, and tables under outputs/ are
# intentionally versioned so results can be reviewed and shared by the team.
# Keep only temporary test/smoke files and heavyweight training checkpoints local.
outputs/.pytest-tmp*/
outputs/preprocess-smoke/
outputs/**/smoke_*
outputs/**/checkpoints/
outputs/**/checkpoint/
outputs/**/checkpoint-*/
outputs/**/*.safetensors
outputs/**/*.ckpt
outputs/**/*.pt
outputs/**/*.pth
outputs/**/pytorch_model*.bin
