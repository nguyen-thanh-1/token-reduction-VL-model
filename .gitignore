# Python-generated files
__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
wheels/
*.egg-info

# Project-local package manager caches
.uv-cache/

# Virtual environments
.venv

# Downloaded datasets and experiment artifacts are local and should not be committed.
data/**/*
!data/**/
!data/**/.gitkeep
outputs/**/*
!outputs/**/
!outputs/**/.gitkeep
