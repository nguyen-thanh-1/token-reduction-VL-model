                    <mxGeometry x="2545" y="770" width="155" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="da-block-note" value="&lt;b&gt;Same decoder block for text and image positions:&lt;/b&gt;&#10;after fusion there is one joint sequence. Causal self-attention mixes information across allowed earlier positions; no separate text decoder and image decoder exist.&#10;&#10;&lt;b&gt;Future pruning research:&lt;/b&gt; possible intervention points include visual embeddings before fusion or selected decoder stages. This baseline retains all Nvisual tokens emitted by the built-in 2×2 merger." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=left;spacingLeft=14;" parent="da-1" vertex="1">
                    <mxGeometry x="1420" y="960" width="1500" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="da-residual-note" value="Residual path 1: xℓ bypasses attention sublayer　•　Residual path 2: x′ bypasses MLP sublayer　•　Both preserve [B, N, 2048]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=13;align=center;" parent="da-1" vertex="1">
                    <mxGeometry x="80" y="960" width="1300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="da-token-note" value="During prefill, N = Ntext_and_special + Nvisual. During generation, the decoder appends one new text token per step; cached visual/text K/V remain available without re-encoding the image." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E8FB;strokeColor=#6C8EBF;fontSize=14;align=center;" parent="da-1" vertex="1">
