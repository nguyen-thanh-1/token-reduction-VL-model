    <diagram id="token-flow-detail" name="04 - Token flow and fusion">
        <mxGraphModel dx="2398" dy="1246" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1250" math="0" shadow="0">
            <root>
                <mxCell id="tf-0"/>
                <mxCell id="tf-1" parent="tf-0"/>
                <mxCell id="tf-title" value="&lt;b&gt;Qwen3-VL-2B-Instruct — TOKEN FLOW AND MULTIMODAL FUSION&lt;/b&gt;&#10;Image placeholders are expanded first, then their text embeddings are replaced in-place by visual embeddings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=19;align=center;" parent="tf-1" vertex="1">
                    <mxGeometry x="40" y="20" width="2720" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="tf-legend" value="&lt;font color=&quot;#4A86E8&quot;&gt;■ text/special-token path&lt;/font&gt;　 &lt;font color=&quot;#6AA84F&quot;&gt;■ image-token path&lt;/font&gt;　 &lt;font color=&quot;#8E7CC3&quot;&gt;■ fusion and positions&lt;/font&gt;　 Hidden width after embedding/merger: 2048" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=14;align=center;" parent="tf-1" vertex="1">
                    <mxGeometry x="40" y="105" width="2720" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="tf-text-bg" value="&lt;b&gt;A. TEXT + SPECIAL TOKENS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=14;fillColor=#EAF2FF;strokeColor=#6C8EBF;fontSize=16;" parent="tf-1" vertex="1">
                    <mxGeometry x="40" y="170" width="830" height="940" as="geometry"/>
                </mxCell>
                <mxCell id="tf-image-bg" value="&lt;b&gt;B. IMAGE → VISUAL TOKENS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=14;fillColor=#EAF4E5;strokeColor=#82B366;fontSize=16;" parent="tf-1" vertex="1">
                    <mxGeometry x="910" y="170" width="700" height="940" as="geometry"/>
                </mxCell>
                <mxCell id="tf-fusion-bg" value="&lt;b&gt;C. IN-PLACE FUSION → JOINT SEQUENCE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=14;fillColor=#F3E8F7;strokeColor=#9673A6;fontSize=16;" parent="tf-1" vertex="1">
                    <mxGeometry x="1650" y="170" width="1110" height="940" as="geometry"/>
                </mxCell>
                <mxCell id="tf-template" value="&lt;b&gt;Chat template before tokenization&lt;/b&gt;&#10;&#10;[system/user text]&#10;&amp;lt;|vision_start|&amp;gt; &amp;lt;|image_pad|&amp;gt; × Nvisual &amp;lt;|vision_end|&amp;gt;&#10;[question] [assistant prefix]&#10;&#10;The processor expands one image marker into exactly Nvisual image placeholders." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;align=left;spacingLeft=14;" parent="tf-1" vertex="1">
                    <mxGeometry x="100" y="225" width="710" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="tf-tokenizer" value="&lt;b&gt;Qwen tokenizer&lt;/b&gt;&#10;text + special tokens → IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;" parent="tf-1" vertex="1">
                    <mxGeometry x="100" y="465" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="tf-inputids" value="&lt;b&gt;input_ids&lt;/b&gt;&#10;shape [B, N]&#10;image token ID = 151655" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;" parent="tf-1" vertex="1">
                    <mxGeometry x="520" y="465" width="290" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="tf-embed" value="&lt;b&gt;Embedding table&lt;/b&gt;&#10;151,936 × 2048&#10;lookup(input_ids)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;" parent="tf-1" vertex="1">
                    <mxGeometry x="100" y="625" width="280" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="tf-textemb" value="&lt;b&gt;Initial token embeddings&lt;/b&gt;&#10;shape [B, N, 2048]&#10;placeholder slots still contain learned text embeddings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;" parent="tf-1" vertex="1">
                    <mxGeometry x="500" y="625" width="310" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="tf-text-note" value="&lt;b&gt;What counts as Ntext_and_special?&lt;/b&gt;&#10;All non-image-placeholder positions: user/system words, control markers, vision_start, vision_end, assistant prefix, and other chat-template tokens.&#10;&#10;&lt;b&gt;Baseline input_tokens = Ntotal&lt;/b&gt; = input_ids.shape[-1]." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E8FB;strokeColor=#6C8EBF;fontSize=14;align=left;spacingLeft=14;" parent="tf-1" vertex="1">
                    <mxGeometry x="100" y="810" width="710" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="tf-image" value="&lt;b&gt;RGB image&lt;/b&gt;&#10;dynamic H × W&#10;(video also supported by model)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=14;" parent="tf-1" vertex="1">
                    <mxGeometry x="1020" y="230" width="480" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="tf-imageproc" value="&lt;b&gt;Image processor&lt;/b&gt;&#10;resize/normalize → grid_thw = (Tgrid, Hgrid, Wgrid)&#10;patch size 16 • temporal patch 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=14;" parent="tf-1" vertex="1">
                    <mxGeometry x="1020" y="375" width="480" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="tf-vit" value="&lt;b&gt;Vision encoder main stream&lt;/b&gt;&#10;Conv3D patchify → 24 ViT blocks (hidden 1024)&#10;→ final 2×2 PatchMerger → 2048-D vectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=14;" parent="tf-1" vertex="1">
                    <mxGeometry x="1020" y="540" width="480" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="tf-imageemb" value="&lt;b&gt;image_embeds&lt;/b&gt;&#10;shape [Nvisual, 2048]&#10;one vector per merged visual token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=14;fontStyle=1;" parent="tf-1" vertex="1">
                    <mxGeometry x="1020" y="715" width="480" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="tf-vformula" value="&lt;b&gt;Visual-token count&lt;/b&gt;&#10;Nvisual = (Tgrid × Hgrid × Wgrid) / merge_size²&#10;merge_size = 2 ⇒ divide by 4&#10;&#10;Dynamic resolution therefore changes Nvisual." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;" parent="tf-1" vertex="1">
                    <mxGeometry x="1020" y="875" width="480" height="155" as="geometry"/>
