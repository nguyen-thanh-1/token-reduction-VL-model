                    <mxGeometry x="605" y="835" width="165" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="dl-attn" value="causal grouped-query attention&#10;16 Q heads / 8 KV heads&#10;KV groups repeated ×2&#10;+ KV cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;" parent="1" vertex="1">
