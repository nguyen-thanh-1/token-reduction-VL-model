                    <mxGeometry x="745" y="745" width="225" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="da-attn" value="&lt;b&gt;Causal grouped-query attention&lt;/b&gt;&#10;16 Q heads attend to 8 KV heads&#10;each KV head shared by 2 Q heads&#10;causal mask + optional KV cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;" parent="da-1" vertex="1">
