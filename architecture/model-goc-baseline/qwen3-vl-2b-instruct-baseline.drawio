                <mxCell id="da-ds3" value="&lt;b&gt;DeepStack feature #3&lt;/b&gt;&#10;index 17 = after ViT block 18&#10;merged to [Nvisual, 2048]&#10;add only where image_mask = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" parent="da-1" vertex="1">
