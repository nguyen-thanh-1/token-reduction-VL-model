                <mxCell id="da-ds-note" value="&lt;b&gt;Important:&lt;/b&gt; DeepStack performs residual feature injection at existing visual positions after layers 0, 1, and 2. It neither appends tokens nor changes N." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;align=left;spacingLeft=12;" parent="da-1" vertex="1">
                    <mxGeometry x="1460" y="190" width="630" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="da-generation-note" value="&lt;b&gt;Prefill:&lt;/b&gt; all N text + visual positions are processed together.&#10;&lt;b&gt;Decode:&lt;/b&gt; each step appends one generated text token; the original visual tokens remain fixed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E8FB;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=12;" parent="da-1" vertex="1">
                    <mxGeometry x="2170" y="190" width="610" height="90" as="geometry"/>
                </mxCell>
