                </mxCell>
                <mxCell id="next-token" value="&lt;b&gt;Greedy next-token selection&lt;/b&gt;&#10;argmax over 151,936 tokens&#10;do_sample=false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;fontSize=13;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="5420" y="435" width="500" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="append-token" value="&lt;b&gt;Append generated text token&lt;/b&gt;&#10;update per-layer KV cache&#10;repeat until EOS or 32 tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E8FB;strokeColor=#6C8EBF;fontSize=13;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="5420" y="610" width="500" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="decoded-answer" value="&lt;b&gt;Decoded answer&lt;/b&gt;&#10;short phrase / option letter / yes-no&#10;output_tokens = generated length" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;fontSize=13;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="5420" y="785" width="500" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="evaluation" value="&lt;b&gt;Dataset-specific evaluation&lt;/b&gt;&#10;GQA: normalized short-answer accuracy&#10;MMBench: parsed A–E option accuracy&#10;MME: yes/no accuracy + pair Accuracy+ + total score&#10;&#10;Efficiency: latency • tokens • peak VRAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;fontSize=13;align=left;spacingLeft=14;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="5420" y="960" width="500" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="vit-detail-bg" value="&lt;b&gt;A. INTERNAL VISIONBLOCK + PATCHMERGER DETAIL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;fillColor=#F4FAF1;strokeColor=#82B366;fontSize=16;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1210" width="2380" height="535" as="geometry"/>
                </mxCell>
                <mxCell id="vb-in" value="xℓ&#10;[Npatch,1024]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1325" width="150" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="vb-ln1" value="LayerNorm&#10;1024, ε=1e−6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="270" y="1325" width="155" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="vb-attn" value="&lt;b&gt;Vision self-attention&lt;/b&gt;&#10;16 heads × 64-D&#10;QKV: 1024→3072&#10;2D rotary positions&#10;O: 1024→1024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="465" y="1305" width="270" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="vb-res1" value="Residual #1&#10;x′ = xℓ + Attn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="775" y="1325" width="175" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="vb-ln2" value="LayerNorm&#10;1024, ε=1e−6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="990" y="1325" width="155" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="vb-mlp" value="&lt;b&gt;Vision MLP&lt;/b&gt;&#10;fc1 1024→4096&#10;GELU&#10;fc2 4096→1024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1185" y="1305" width="240" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="vb-res2" value="Residual #2&#10;xℓ+1 = x′ + MLP&#10;[Npatch,1024]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1465" y="1315" width="190" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="merger-detail" value="&lt;b&gt;Final PatchMerger&lt;/b&gt;&#10;LN each 1024-D patch → group each spatial 2×2 neighborhood&#10;concatenate 4 patches: 4×1024 = 4096&#10;Linear 4096→4096 → GELU → Linear 4096→2048&#10;[Npatch,1024] → [Npatch/4,2048]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1700" y="1285" width="660" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="vision-residual-note" value="Both residual paths preserve the patch-token count Npatch and hidden width 1024 inside every ViT block. The built-in 2×2 PatchMerger is the only baseline operation that reduces the spatial token count, deterministically by 4." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=13;align=left;spacingLeft=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1505" width="850" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="deepstack-merger-note" value="&lt;b&gt;DeepStack merger difference&lt;/b&gt;&#10;The three DeepStack branches group the same 2×2 patches first, then apply LayerNorm over the grouped 4096-D representation before the same 4096→4096→2048 MLP. Each branch therefore emits [Nvisual,2048]." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;spacingLeft=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="980" y="1505" width="1380" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="decoder-detail-bg" value="&lt;b&gt;B. INTERNAL STRUCTURE OF ONE PRE-NORM LANGUAGE DECODER LAYER — REPEATED 28 TIMES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;fillColor=#FFF9ED;strokeColor=#D79B00;fontSize=16;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="2470" y="1210" width="3490" height="535" as="geometry"/>
                </mxCell>
                <mxCell id="db-in" value="xℓ&#10;[B,N,2048]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="2510" y="1330" width="150" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="db-norm1" value="RMSNorm&#10;2048, ε=1e−6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="2690" y="1330" width="155" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="db-qkv" value="&lt;b&gt;Bias-free Q/K/V&lt;/b&gt;&#10;Q 2048→2048 = 16×128&#10;Q shape [B,16,N,128]&#10;K,V 2048→1024 = 8×128&#10;K,V shape [B,8,N,128]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="2875" y="1305" width="270" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="db-qknorm" value="&lt;b&gt;Per-head Q/K RMSNorm&lt;/b&gt;&#10;+ M-RoPE on Q,K&#10;position IDs T/H/W&#10;sections [24,20,20]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="3175" y="1305" width="270" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="db-attn" value="&lt;b&gt;Causal grouped-query attention&lt;/b&gt;&#10;16 Q heads / 8 KV heads&#10;each KV head shared by 2 Q heads&#10;causal mask + KV cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="3475" y="1305" width="300" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="db-oproj" value="&lt;b&gt;o_proj + residual #1&lt;/b&gt;&#10;concat heads = 2048&#10;Linear 2048→2048&#10;x′ = xℓ + Attention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="3805" y="1305" width="255" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="db-norm2" value="RMSNorm&#10;2048, ε=1e−6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="4090" y="1330" width="155" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="db-gateup" value="&lt;b&gt;Bias-free parallel projections&lt;/b&gt;&#10;gate_proj 2048→6144&#10;up_proj 2048→6144" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="4275" y="1315" width="270" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="db-swiglu" value="&lt;b&gt;SwiGLU&lt;/b&gt;&#10;SiLU(gate) ⊙ up&#10;[B,N,6144]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="4575" y="1325" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="db-down" value="&lt;b&gt;down_proj + residual #2&lt;/b&gt;&#10;Linear 6144→2048&#10;xℓ+1 = x′ + MLP(RMSNorm(x′))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="4805" y="1315" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="db-out" value="xℓ+1&#10;[B,N,2048]&#10;N unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="5135" y="1320" width="170" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="db-joint-note" value="&lt;b&gt;One decoder for both modalities&lt;/b&gt;&#10;After fusion, text and image vectors occupy positions in the same sequence. The decoder does not contain a separate image-only branch; causal self-attention mixes information over all allowed previous positions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;align=left;spacingLeft=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="5335" y="1285" width="575" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="db-residual-note" value="Residual path 1 bypasses attention; residual path 2 bypasses the MLP. Both preserve [B,N,2048]. DeepStack additions occur only after complete decoder layers 0, 1, and 2—not inside the attention or MLP sublayers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=13;align=left;spacingLeft=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="2510" y="1510" width="1580" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="db-cache-note" value="&lt;b&gt;KV-cache dimensions per layer&lt;/b&gt;&#10;K and V cache shape: [B,8,Ncached,128]. Visual and prompt tokens are cached during prefill; each decode step computes Q/K/V only for the newly appended text token." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E8FB;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="4130" y="1510" width="850" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="db-pruning-note" value="&lt;b&gt;Future experimental hook points&lt;/b&gt;&#10;Candidate interventions may operate on visual embeddings before fusion or on selected decoder stages. Every experiment must state token budget, layer, scoring signal, and spatial safeguard; this diagram itself remains the unpruned reference." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;spacingLeft=12;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="5020" y="1510" width="890" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="ledger-bg" value="&lt;b&gt;C. END-TO-END TOKEN / TENSOR LEDGER AND EXPERIMENT CONTRACT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;fillColor=#F7F7F9;strokeColor=#6B7280;fontSize=16;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1785" width="5920" height="625" as="geometry"/>
                </mxCell>
                <mxCell id="ledger-image" value="&lt;b&gt;① Image patches&lt;/b&gt;&#10;pixel_values + grid_thw&#10;Conv3D → [Npatch,1024]&#10;Npatch=Tgrid×Hgrid×Wgrid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1870" width="930" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="ledger-visual" value="&lt;b&gt;② Merged visual tokens&lt;/b&gt;&#10;final PatchMerger&#10;[Nvisual,2048]&#10;Nvisual=Npatch/4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="1870" width="930" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="ledger-text" value="&lt;b&gt;③ Tokenized prompt&lt;/b&gt;&#10;Ntext_and_special non-image positions&#10;+ Nvisual placeholders&#10;input_ids [B,Ntotal]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E8FB;strokeColor=#6C8EBF;fontSize=13;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="2020" y="1870" width="930" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="ledger-fused" value="&lt;b&gt;④ Fused multimodal sequence&lt;/b&gt;&#10;Nvisual placeholder vectors replaced in-place&#10;[B,Ntotal,2048]&#10;Ntotal=Ntext_and_special+Nvisual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="2990" y="1870" width="930" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="ledger-decoder" value="&lt;b&gt;⑤ Decoder + logits&lt;/b&gt;&#10;28 layers preserve [B,Ntotal,2048]&#10;final logits [B,Ntotal,151936]&#10;DeepStack additions preserve Ntotal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="3960" y="1870" width="930" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="ledger-generation" value="&lt;b&gt;⑥ Autoregressive text output&lt;/b&gt;&#10;step s input length = Ntotal+s&#10;one new text token per step&#10;answer ≤32 generated tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=13;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="4930" y="1870" width="970" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="token-definitions" value="&lt;b&gt;Token definitions used in experiments&lt;/b&gt;&#10;• Npatch: unmerged ViT patch tokens.&#10;• Nvisual: tokens after the built-in 2×2 merger; this is the baseline visual-token count.&#10;• Ntext_and_special: all non-image-placeholder text/control positions.&#10;• Ntotal: decoder prefill length and recorded input_tokens.&#10;• retained_visual_ratio = Nvisual_after_experimental_pruning / Nvisual_baseline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;fontSize=13;align=left;spacingLeft=14;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="80" y="2050" width="1420" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="deepstack-contract-bottom" value="&lt;b&gt;DeepStack shape contract&lt;/b&gt;&#10;Three fixed feature tensors, each [Nvisual,2048], are injected after language layers 0, 1, and 2 only at image_mask positions. They reuse intermediate visual features but neither create new token positions nor reduce the sequence length." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;spacingLeft=14;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1540" y="2050" width="1420" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="baseline-contract-bottom" value="&lt;b&gt;Full-token baseline contract&lt;/b&gt;&#10;No learned, random, attention-based, question-aware, or adaptive token pruning is applied. The only token-count reduction is Qwen3-VL's built-in deterministic 2×2 PatchMerger. Future methods must compare against this exact path and model revision." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;align=left;spacingLeft=14;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="3000" y="2050" width="1420" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="experiment-contract" value="&lt;b&gt;Required comparison axes&lt;/b&gt;&#10;&lt;font color=&quot;#067647&quot;&gt;Quality:&lt;/font&gt; GQA accuracy • MMBench accuracy • MME accuracy, Accuracy+, total score.&#10;&lt;font color=&quot;#2855D9&quot;&gt;Efficiency:&lt;/font&gt; retained visual-token ratio • latency • throughput • peak VRAM • FLOPs/compute proxy.&#10;&lt;font color=&quot;#9C2C77&quot;&gt;Controls:&lt;/font&gt; full-token • random-K • uniform-K • question-aware fixed-K." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;fontSize=13;align=left;spacingLeft=14;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="4460" y="2050" width="1440" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="&lt;font color=&quot;#4A86E8&quot;&gt;━━ Text/control path&lt;/font&gt;　 &lt;font color=&quot;#6AA84F&quot;&gt;━━ Main visual path&lt;/font&gt;　 &lt;font color=&quot;#BF9000&quot;&gt;┄┄ DeepStack feature injection&lt;/font&gt;　 &lt;font color=&quot;#8E7CC3&quot;&gt;━━ Fusion/joint sequence&lt;/font&gt;　 &lt;font color=&quot;#D79B00&quot;&gt;━━ Decoder/generation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=14;align=center;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="600" y="2305" width="4800" height="55" as="geometry"/>
                </mxCell>
