<mxfile host="app.diagrams.net"><diagram id="pp3-3d" name="PP3_3d_attention_scorer"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2840" pageHeight="1480" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;PP3 — chọn token ảnh theo câu hỏi bằng score head học từ attention (head 3d_attn50k) trên Qwen3-VL-2B-Instruct&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=26;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2600" height="50" as="geometry"/></mxCell><mxCell id="t2" value="Nguyễn Thiện Thanh, Nguyễn Trung Hiếu, Gia Bảo — GVHD: Lê Phú Nguyên. Qwen3-VL đóng băng hoàn toàn; chỉ score head (1.993.153 tham số) được huấn luyện." style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2600" height="30" as="geometry"/></mxCell><mxCell id="b3" value="Qwen3-VL đóng băng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="230" height="34" as="geometry"/></mxCell><mxCell id="b4" value="Học (score head)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="290" y="96" width="230" height="34" as="geometry"/></mxCell><mxCell id="b5" value="Thuật toán cố định, không học" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="540" y="96" width="230" height="34" as="geometry"/></mxCell><mxCell id="b6" value="Huấn luyện offline (một lần)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="790" y="96" width="230" height="34" as="geometry"/></mxCell><mxCell id="b7" value="Tensor / dữ liệu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1040" y="96" width="230" height="34" as="geometry"/></mxCell><mxCell id="p8" value="&lt;b&gt;A. LUỒNG SUY LUẬN (mỗi câu hỏi) — ví dụ ảnh 160 token, mức L3 (r = 2/9 → K = 36)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;fontSize=18;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;arcSize=2;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="2780" height="720" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;Đầu vào&lt;/b&gt;&lt;br&gt;Ảnh RGB (bất kỳ kích thước)&lt;br&gt;+ câu hỏi văn bản&lt;br&gt;+ mức budget r ∈ {1/18, 1/9, 2/9, 1/3, 1/2}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="230" height="150" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;Processor Qwen3-VL&lt;/b&gt;&lt;br&gt;resize bội số 32 px&lt;br&gt;patch 16 px → lưới H×W patch&lt;br&gt;prompt chat có&lt;br&gt;&amp;lt;|image_pad|&amp;gt; × N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="250" height="150" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;Vision Encoder (ViT)&lt;/b&gt;&lt;br&gt;24 lớp, hidden 1024, 407M tham số&lt;br&gt;PatchMerger 2×2 → 1 token ≈ 32×32 px&lt;br&gt;&lt;br&gt;nhánh chính → &lt;b&gt;v&lt;/b&gt; [N × 2048]&lt;br&gt;DeepStack từ lớp 5, 11, 17 → &lt;b&gt;f⁽¹⁾,f⁽²⁾,f⁽³⁾&lt;/b&gt; [N × 2048]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="630" y="200" width="290" height="190" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;Embedding từ của LLM&lt;/b&gt;&lt;br&gt;embed_tokens (bảng 151.936 × 2048)&lt;br&gt;→ embedding câu hỏi &lt;b&gt;e&lt;/b&gt; [N_q × 2048]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="630" y="430" width="290" height="110" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;S1 — Đặc trưng token (không học)&lt;/b&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;• PCA cố định (fit 1 lần trên 1000 ảnh train):&lt;br&gt;&amp;nbsp;&amp;nbsp;v 2048→256; mỗi mức DeepStack 2048→64;&lt;br&gt;&amp;nbsp;&amp;nbsp;câu hỏi 2048→256&lt;br&gt;• 2 điểm DSFold: z_rel (liên quan câu hỏi),&lt;br&gt;&amp;nbsp;&amp;nbsp;z_ms (khác biệt giữa các mức)&lt;br&gt;• vị trí Fourier của ô lưới (16 số)&lt;br&gt;• log r (budget)&lt;br&gt;&lt;br&gt;ghép → &lt;b&gt;u_i&lt;/b&gt; = [256 ; 3×64 ; 2 ; 16 ; 1] = &lt;b&gt;467 số / token&lt;/b&gt;&lt;br&gt;câu hỏi → &lt;b&gt;w&lt;/b&gt; [N_q × 256]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="980" y="200" width="330" height="340" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;S2 — Score head 3d (1,99M tham số, HỌC)&lt;/b&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;① Linear 467→256 → h [N×256]&lt;br&gt;② &lt;b&gt;Self-attention&lt;/b&gt; giữa các token ảnh&lt;br&gt;&amp;nbsp;&amp;nbsp;(token biết ngữ cảnh toàn ảnh)&lt;br&gt;③ Câu hỏi: + vị trí từ, 1 lớp Transformer&lt;br&gt;④ &lt;b&gt;Cross-attention&lt;/b&gt; token → từ câu hỏi&lt;br&gt;⑤ FFN 256→1024→256, LayerNorm&lt;br&gt;⑥ a_i = Linear(h_i) (điểm chung)&lt;br&gt;⑦ b_i = logsumexp_w ⟨W_k h_i, W_q w_w⟩/√256&lt;br&gt;&amp;nbsp;&amp;nbsp;(token khớp từ nào nhất trong câu hỏi)&lt;br&gt;⑧ &lt;b&gt;s_i = a_i + b_i&lt;/b&gt; → s [N]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1360" y="200" width="360" height="340" as="geometry"/></mxCell><mxCell id="b15" value="&lt;b&gt;Chất lượng&lt;/b&gt;&lt;br&gt;q̂_i = softplus(s_i) + 0,001&lt;br&gt;&lt;br&gt;chất lượng dương&lt;br&gt;cho từng token&lt;br&gt;[N]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1770" y="290" width="200" height="160" as="geometry"/></mxCell><mxCell id="b16" value="&lt;b&gt;S3 — DPP chọn K token&lt;/b&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;K = ⌈r·N⌉ (ví dụ 36 / 160)&lt;br&gt;&lt;br&gt;Kernel &lt;b&gt;L = diag(q̂)·S·diag(q̂)&lt;/b&gt;&lt;br&gt;S_ij = cos(v_i, v_j)&lt;br&gt;&lt;br&gt;MAP tham lam: mỗi bước chọn token làm&lt;br&gt;log det(L_chọn) tăng nhiều nhất&lt;br&gt;→ ưu tiên token &lt;b&gt;điểm cao&lt;/b&gt; nhưng&lt;br&gt;&lt;b&gt;khác nhau&lt;/b&gt; (không chọn 36 token&lt;br&gt;giống hệt nhau cùng một vùng)&lt;br&gt;&lt;br&gt;ra: tập giữ K chỉ số, tập bỏ N−K&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2020" y="200" width="330" height="340" as="geometry"/></mxCell><mxCell id="b17" value="&lt;b&gt;S4 — DeepStack fold&lt;/b&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;Mỗi token bị bỏ d gán cho token giữ k:&lt;br&gt;a(d) = argmax_k cos(v_d,v_k) − λ·dist(d,k)/diag&lt;br&gt;&lt;br&gt;Mỗi mức DeepStack l = 1..3:&lt;br&gt;f'_k = norm-match( f_k + γ Σ_{d∈A(k)} w_dk f_d )&lt;br&gt;w_dk = softmax_d( cos(v_d,v_k) / τ )&lt;br&gt;&lt;br&gt;λ = 0,5; γ = 0,5; τ = 0,1&lt;br&gt;nhánh chính v &lt;b&gt;không đổi&lt;/b&gt;&lt;br&gt;(ablation: fold trung tính trên GQA)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2400" y="200" width="360" height="340" as="geometry"/></mxCell><mxCell id="b18" value="&lt;b&gt;LLM Qwen3 (đóng băng)&lt;/b&gt;&lt;br&gt;Chuỗi vào = text + &lt;b&gt;K token ảnh giữ lại&lt;/b&gt; (thay vì N) tại &lt;b&gt;vị trí M-RoPE gốc&lt;/b&gt; (t, h, w) của chúng&lt;br&gt;DeepStack: f'⁽¹⁾,f'⁽²⁾,f'⁽³⁾ của K token cộng vào hidden state ở lớp 0, 1, 2&lt;br&gt;28 lớp, hidden 2048, 16 Q / 8 KV head, FFN 6144, 1,72B tham số&lt;br&gt;Attention nhanh (SDPA / FlashAttention) — PP3 không cần trọng số attention lúc suy luận" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1760" y="620" width="740" height="200" as="geometry"/></mxCell><mxCell id="b19" value="&lt;b&gt;Đầu ra&lt;/b&gt;&lt;br&gt;greedy decode&lt;br&gt;tối đa 32 token&lt;br&gt;→ câu trả lời" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2560" y="700" width="200" height="120" as="geometry"/></mxCell><mxCell id="b20" value="&lt;b&gt;Hiệu quả (kết quả test)&lt;/b&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;• LLM đọc ít token hơn: GQA 294 → 86 (−71%),&lt;br&gt;&amp;nbsp;&amp;nbsp;MME 1790 → 425 (−76%) ở L3&lt;br&gt;• KV cache ngắn hơn tương ứng&lt;br&gt;• Chi phí thêm: S1–S4 ≈ 10–90 ms / câu&lt;br&gt;• Chất lượng L3: GQA −0,50, MMB −1,71 điểm;&lt;br&gt;&amp;nbsp;&amp;nbsp;MME perception 1502 / 1512&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#C9A400;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="980" y="620" width="470" height="200" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="pixel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="id câu hỏi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b10" target="b12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="v, f⁽¹⁻³⁾" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b11" target="b13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="e" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="b12" target="b13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="u [N×467], w" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b13" target="b14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b14" target="b15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="q̂" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b15" target="b16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="giữ / bỏ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b16" target="b17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="v_kept [K×2048]&lt;br&gt;f'_kept [3×K×2048]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="token văn bản" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b12" target="b18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b18" target="b19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p33" value="&lt;b&gt;B. HUẤN LUYỆN SCORE HEAD — chưng cất attention của chính mô hình full (offline, một lần)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;fontSize=18;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;arcSize=2;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="890" width="1700" height="560" as="geometry"/></mxCell><mxCell id="b34" value="&lt;b&gt;Dữ liệu&lt;/b&gt;&lt;br&gt;GQA train balanced&lt;br&gt;50.000 câu hỏi&lt;br&gt;(ảnh khác tập đánh giá)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="960" width="230" height="150" as="geometry"/></mxCell><mxCell id="b35" value="&lt;b&gt;Lượt teacher&lt;/b&gt;&lt;br&gt;Qwen3-VL full token, trả lời greedy&lt;br&gt;→ đáp án của chính mô hình&lt;br&gt;&lt;br&gt;chạy lại &lt;b&gt;teacher-forced&lt;/b&gt; trên đáp án đó,&lt;br&gt;attention &lt;b&gt;eager&lt;/b&gt; (chỉ lượt này)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="330" y="940" width="300" height="190" as="geometry"/></mxCell><mxCell id="b36" value="&lt;b&gt;Đọc attention&lt;/b&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;hook lớp 8–19 đọc A [16 head × L × L]&lt;br&gt;hàng: vị trí trả lời + vị trí câu hỏi&lt;br&gt;cột: N vị trí token ảnh → [16 × R × N]&lt;br&gt;chuẩn hóa lại trên N cột (bỏ phần nhìn chữ)&lt;br&gt;trung bình head → lớp → hàng&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="680" y="940" width="330" height="190" as="geometry"/></mxCell><mxCell id="b37" value="&lt;b&gt;Nhãn teacher&lt;/b&gt;&lt;br&gt;p_ans [N], p_q [N]&lt;br&gt;&lt;br&gt;&lt;b&gt;p = 0,5·p_ans + 0,5·p_q&lt;/b&gt;&lt;br&gt;&lt;br&gt;N số ≥ 0, tổng = 1&lt;br&gt;(bản đồ nhiệt trên các token ảnh)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1060" y="940" width="280" height="190" as="geometry"/></mxCell><mxCell id="b38" value="&lt;b&gt;Học score head&lt;/b&gt;&lt;br&gt;Loss = CE( p , softmax(s) ), T = 1&lt;br&gt;AdamW lr 3e-4 cosine, wd 0,01&lt;br&gt;batch 16, 20 epoch, patience 3&lt;br&gt;&lt;br&gt;recall top-K so với teacher: 0,836" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1390" y="940" width="300" height="190" as="geometry"/></mxCell><mxCell id="t39" value='&lt;b&gt;Vì sao làm vậy?&lt;/b&gt; Attention cho biết LLM thực sự "nhìn" token ảnh nào khi trả lời câu hỏi. Lúc suy luận, đọc attention bên trong LLM (như FastV) buộc phải chạy LLM trên đủ N token và dùng attention eager (chậm, tốn bộ nhớ: ảnh MME 13.862 token cần ma trận 16 × 13.862² ≈ 6 GB). PP3 học trước một mạng nhỏ &lt;b&gt;đoán&lt;/b&gt; bản đồ attention đó từ chính token ảnh + câu hỏi, nên chọn token &lt;b&gt;trước&lt;/b&gt; LLM và LLM vẫn dùng FlashAttention.&lt;br&gt;&lt;br&gt;&lt;b&gt;Nguồn nhãn thay thế (ablation):&lt;/b&gt; nhãn gradient × input (head 3a). Với 50k nhãn hai nguồn ngang nhau; với 10k nhãn teacher hơn +1,70 điểm.&lt;br&gt;&lt;b&gt;Giới hạn:&lt;/b&gt; teacher bắt chước mô hình full nên trần kỳ vọng là ngang full.' style="text;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="1160" width="1640" height="280" as="geometry"/></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b34" target="b35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e41" value="A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b35" target="b36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b36" target="b37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e43" value="mục tiêu p" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b37" target="b38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e44" value="trọng số đã học" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673A6;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b38" target="b14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p45" value="&lt;b&gt;C. BIẾN THỂ DỄ DIỄN GIẢI PP3-fc (focus + context)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF7FD;strokeColor=#9673A6;fontSize=18;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;arcSize=2;opacity=60;" vertex="1" parent="1"><mxGeometry x="1760" y="890" width="1040" height="560" as="geometry"/></mxCell><mxCell id="b46" value="&lt;b&gt;Attention sink&lt;/b&gt;&lt;br&gt;Teacher dồn nhiều attention vào nền (trời, tường) cho &lt;b&gt;mọi&lt;/b&gt; câu hỏi:&lt;br&gt;tập giữ của các câu hỏi khác nhau trên cùng ảnh trùng 0,65 (L3)&lt;br&gt;so với 0,13 nếu chọn ngẫu nhiên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#C9A400;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1790" y="950" width="470" height="150" as="geometry"/></mxCell><mxCell id="b47" value="&lt;b&gt;Nhãn tương phản&lt;/b&gt;&lt;br&gt;&lt;b&gt;t ∝ max(0, p − trung bình p của các câu hỏi khác cùng ảnh)&lt;/b&gt;&lt;br&gt;bỏ phần chung của ảnh, giữ phần riêng của câu hỏi&lt;br&gt;head 3d thứ hai học t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2300" y="950" width="470" height="150" as="geometry"/></mxCell><mxCell id="b48" value="&lt;b&gt;Focus (vùng theo câu hỏi)&lt;/b&gt;&lt;br&gt;25% của K: mọc vùng liên thông trên điểm tương phản&lt;br&gt;(chuẩn hóa z, thưởng 8 láng giềng β = 1)&lt;br&gt;→ vùng gọn: 1,4–1,8 vùng / 10 token&lt;br&gt;trùng giữa câu hỏi chỉ 0,15–0,18" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1790" y="1150" width="470" height="160" as="geometry"/></mxCell><mxCell id="b49" value="&lt;b&gt;Context&lt;/b&gt;&lt;br&gt;75% còn lại: DPP trên các token chưa chọn&lt;br&gt;với chất lượng q̂ của head chính&lt;br&gt;&lt;br&gt;L5 (50%): GQA −0,15, MMB −0,21,&lt;br&gt;MME perception 1534 (&gt; full 1512)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2300" y="1150" width="470" height="160" as="geometry"/></mxCell><mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b46" target="b47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b47" target="b48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e52" value="phần còn lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b48" target="b49"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>