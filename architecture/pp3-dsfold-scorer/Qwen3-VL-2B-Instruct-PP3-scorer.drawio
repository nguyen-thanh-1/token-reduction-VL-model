        <mxCell id="bGAilfCWtUQ7A0YQxOPz-54" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;align=left;spacingLeft=14;fontColor=#000000;labelBackgroundColor=none;" value="&lt;b&gt;Sequence-length contract&lt;/b&gt;&#10;All 28 layers preserve N and hidden width 2048. DeepStack is an element-wise residual add at existing visual positions. It does not change Nvisual or Ntotal." vertex="1">
