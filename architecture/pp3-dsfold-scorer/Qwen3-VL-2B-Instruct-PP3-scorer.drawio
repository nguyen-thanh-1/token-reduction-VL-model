        <mxCell id="dsf-badge-M8" value="M8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B20000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=18;fontStyle=1;fontSize=15;" vertex="1" parent="1">
