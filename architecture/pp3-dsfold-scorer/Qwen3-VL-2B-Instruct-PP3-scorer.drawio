        </mxCell>
        <mxCell id="dsf-modified" value="&lt;b&gt;&lt;font style='font-size:20px'&gt;Ô BASELINE BỊ THAY ĐỔI (viền đỏ + nhãn M#)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;M1&lt;/b&gt; — Main visual embeddings không vào fusion trực tiếp nữa mà đi qua DSFold&lt;br&gt;&lt;b&gt;M2&lt;/b&gt; — 3 DeepStack features (#1–#3) đi qua DSFold để chấm điểm + fold, không nối thẳng vào decoder&lt;br&gt;&lt;b&gt;M3&lt;/b&gt; — image_mask tính trên input_ids đã rút gọn: chỉ còn K vị trí &amp;lt;|image_pad|&amp;gt;&lt;br&gt;&lt;b&gt;M4&lt;/b&gt; — kiểm tra số vị trí ảnh = K (không còn = N_visual)&lt;br&gt;&lt;b&gt;M5&lt;/b&gt; — masked_scatter v[I_keep] [K,2048] thay vì toàn bộ N_visual token&lt;br&gt;&lt;b&gt;M6&lt;/b&gt; — position_ids tính trên lưới GỐC rồi gather K cột giữ lại; rope_deltas tính lại&lt;br&gt;&lt;b&gt;M7&lt;/b&gt; — N_total′ = N_text_and_special + K; visual_pos_masks có K vị trí; truyền DeepStack′&lt;br&gt;&lt;b&gt;M8&lt;/b&gt; — DeepStack #1–#3 ở decoder layer 0/1/2 nhận DeepStack′ [K,2048] đã fold" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#B20000;strokeWidth=2;dashed=1;fontSize=13;fontColor=#000000;align=left;spacingLeft=8;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="3800" y="250" width="3580" height="260" as="geometry" />
        </mxCell>
        <mxCell id="dsf-badge-p0" value="P0" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B20000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="202.43" y="1118.0" width="46" height="46" as="geometry" />
        </mxCell>
        <mxCell id="dsf-note-p0" value="&lt;b&gt;P0 — baseline đối chứng&lt;/b&gt;&lt;br&gt;Giảm max_pixels sao cho N_visual = K.&lt;br&gt;Giảm cả ViT + LLM. DSFold phải thắng cách này ở cùng K." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#B20000;strokeWidth=2;dashed=1;fontSize=13;fontColor=#000000;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="-380" y="830" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dsf-e-p0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B20000;strokeWidth=3;endArrow=block;endFill=1;dashed=1;strokeWidth=2;endArrow=open;" edge="1" parent="1" source="dsf-note-p0" target="xIS5UHJOj7zLutmTknW8-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dsf-badge-p1" value="P1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B20000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1625" y="748" width="46" height="46" as="geometry" />
        </mxCell>
        <mxCell id="dsf-badge-p3" value="P3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B20000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="6250.0" y="864.0" width="46" height="46" as="geometry" />
        </mxCell>
        <mxCell id="dsf-note-p3" value="&lt;b&gt;P3 — baseline so sánh (FastV-style)&lt;/b&gt;&lt;br&gt;Cắt token theo attention sau layer k ≥ 3:&lt;br&gt;không cần xử lý DeepStack nhưng không giảm layer 0..k−1." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#B20000;strokeWidth=2;dashed=1;fontSize=13;fontColor=#000000;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="6010.0" y="1430" width="520" height="95" as="geometry" />
        </mxCell>
        <mxCell id="dsf-panel-d" value="D. DSFold — THUẬT TOÁN CHI TIẾT (training-free)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#B20000;strokeWidth=4;dashed=1;fontSize=22;fontStyle=1;verticalAlign=top;fontColor=#B20000;arcSize=4;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="2790" y="1749" width="1060" height="535" as="geometry" />
        </mxCell>
        <mxCell id="dsf-algo" value="&lt;b&gt;Input:&lt;/b&gt; v, f₁..f₃ ∈ R^{N×2048}, grid (t,h,w), q ∈ R^{N_q×2048}, ratio r&lt;br&gt;1. K ← ⌈r·N⌉&lt;br&gt;2. z_rel, z_ms như PP1 → &lt;font color='#6A1B9A'&gt;&lt;b&gt;PP3: quality ← softplus(ScoreHead3a(...)) + 10⁻³&lt;/b&gt;&lt;/font&gt;&lt;br&gt;3. L ← diag(q̂) · S · diag(q̂),  S = cos(v, v)&lt;br&gt;4. I_keep ← greedy-MAP-DPP(L, K)   (hoặc max–min diversity)&lt;br&gt;5. với mỗi d ∉ I_keep: a(d) ← argmax_k [cos(v_d, v_k) − λ·dist(d,k)]&lt;br&gt;6. f′ₗ[k] ← norm-match(fₗ[k] + γ·Σ_{a(d)=k} w_dk·fₗ[d])&lt;br&gt;7. pos ← M-RoPE(grid gốc)[:, I_keep];  input_ids: K image_pad&lt;br&gt;8. prefill(v[I_keep], f′, pos) → greedy decode (≤32 token)&lt;br&gt;&lt;br&gt;&lt;b&gt;Kiểm chứng bắt buộc:&lt;/b&gt; r = 100% + không fold ⇒ output trùng baseline.&lt;br&gt;&lt;b&gt;Ablation:&lt;/b&gt; bỏ rel / bỏ ms / bỏ fold / đánh lại position / slice-vs-drop DeepStack." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=13;fontColor=#000000;align=left;spacingLeft=10;verticalAlign=top;labelBackgroundColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="2820" y="1800" width="1000" height="460" as="geometry" />
        </mxCell>
        <mxCell id="dsf-ledger" value="&lt;b&gt;⑦ DSFold token ledger&lt;/b&gt;&lt;br&gt;• N_patch: không đổi (ViT chạy đủ 24 block)&lt;br&gt;• N_visual → K = ⌈r·N_visual⌉&lt;br&gt;• N_total′ = N_text_and_special + K&lt;br&gt;• DeepStack′: 3 × [K, 2048] (đã fold)&lt;br&gt;• position_ids: [3, B, N_total′] gather từ lưới gốc&lt;br&gt;• Compute: ViT giữ nguyên; LLM prefill + KV cache ∝ N_total′" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=13;fontColor=#000000;align=left;spacingLeft=10;verticalAlign=top;labelBackgroundColor=none;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="6290" y="2409" width="1060" height="390" as="geometry" />
        </mxCell>
        <mxCell id="pp3-badge-s1" value="PP3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="3770" y="1000" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pp3-legend" value="&lt;b&gt;&lt;font style='font-size:20px' color='#6A1B9A'&gt;PP3 — CHỈ THAY BƯỚC S1 CỦA DSFold&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Tím&lt;/b&gt;: phần mới của PP3 (score head 3a, PCA cố định, nhãn saliency, huấn luyện route B).&lt;br&gt;• &lt;b&gt;Đỏ&lt;/b&gt;: DSFold/PP1 giữ nguyên bộ tham số D-1.0 (S2 DPP, S3 assign, S4 fold, gather M-RoPE).&lt;br&gt;• &lt;b&gt;Xanh&lt;/b&gt;: Qwen3-VL-2B đóng băng (ViT, embedding, 28 lớp LLM) — không fine-tune.&lt;br&gt;• Panel &lt;b&gt;E&lt;/b&gt; = kiến trúc + luồng inference; &lt;b&gt;F&lt;/b&gt; = luồng huấn luyện; &lt;b&gt;G&lt;/b&gt; = kết quả GQA dev." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=2;dashed=1;fontColor=#000000;align=left;spacingLeft=8;verticalAlign=top;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="360" y="-60" width="3400" height="270" as="geometry" />
        </mxCell>
        <mxCell id="pp3-panel-e" value="E. PP3 — SCORE HEAD 3a (MLP từng token) + LUỒNG INFERENCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F0FA;strokeColor=#6A1B9A;strokeWidth=4;dashed=1;fontSize=22;fontStyle=1;verticalAlign=top;fontColor=#6A1B9A;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="360" y="3000" width="7020" height="820" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-in-v" value="&lt;b&gt;v&lt;/b&gt; main visual [N, 2048]&lt;br&gt;(unit-norm, sau PatchMerger)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="3070" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-in-f" value="&lt;b&gt;f₁, f₂, f₃&lt;/b&gt; DeepStack [N, 2048] ×3&lt;br&gt;(chuẩn hoá theo từng mức)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="3210" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-in-q" value="&lt;b&gt;q&lt;/b&gt; token câu hỏi [N_q, 2048]&lt;br&gt;(bỏ stopword, chưa chạy LLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="3350" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-in-z" value="&lt;b&gt;z_rel, z_ms&lt;/b&gt; [N] từ S1 của PP1&lt;br&gt;(z-score, clip ±3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="3490" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-in-g" value="&lt;b&gt;grid (H′, W′)&lt;/b&gt; + &lt;b&gt;log r&lt;/b&gt;&lt;br&gt;(vị trí token, mức ngân sách)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="3630" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pca" value="&lt;b&gt;PCA cố định&lt;/b&gt; (không huấn luyện)&lt;br&gt;fit 1 lần trên 1000 ảnh GQA train&lt;br&gt;&lt;br&gt;• v: 2048 → 256&lt;br&gt;• fₗ: 2048 → 64 (mỗi mức)&lt;br&gt;• q: 2048 → 256&lt;br&gt;&lt;br&gt;&lt;i&gt;lý do: lưu 50k mẫu thô ≈ 220 GB → ≈ 9 GB&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="900" y="3070" width="380" height="395" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pos" value="&lt;b&gt;Fourier vị trí&lt;/b&gt; [N, 16]&lt;br&gt;sin/cos(2ᵏπ·hàng), sin/cos(2ᵏπ·cột), k = 0..3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="900" y="3490" width="380" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-enc" value="&lt;b&gt;TokenEncoder&lt;/b&gt; (học được)&lt;br&gt;P_v: Linear 256→256&lt;br&gt;P_ℓ: Linear 64→64 (×3)&lt;br&gt;P_q: Linear 256→256&lt;br&gt;&lt;br&gt;&lt;b&gt;u_i&lt;/b&gt; = [P_v v_i ; P₁f₁ ; P₂f₂ ; P₃f₃ ; z_rel ; z_ms ; pos ; log r]&lt;br&gt;= 256 + 3·64 + 2 + 16 + 1 = &lt;b&gt;467-d&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;x_q&lt;/b&gt; = mean_j P_q(q_j)  → 256-d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1380" y="3070" width="520" height="395" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-cat" value="&lt;b&gt;Ghép + tương tác&lt;/b&gt;&lt;br&gt;h_i = [u_i ; x_q ; P_v(v_i) ⊙ x_q]&lt;br&gt;= 467 + 256 + 256 = &lt;b&gt;979-d&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;⊙ cho MLP thấy trực tiếp 'token ảnh khớp câu hỏi', không cần attention&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="2000" y="3070" width="440" height="235" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-mlp" value="&lt;b&gt;MLP từng token&lt;/b&gt; (dùng chung cho mọi i)&lt;br&gt;Linear 979 → 512&lt;br&gt;GELU&lt;br&gt;Dropout 0.1&lt;br&gt;Linear 512 → 256&lt;br&gt;GELU&lt;br&gt;Linear 256 → 1  ⇒  &lt;b&gt;s_i&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="2540" y="3070" width="380" height="235" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-q" value="&lt;b&gt;q̂_i = softplus(s_i) + 10⁻³&lt;/b&gt;  [N]&lt;br&gt;luôn dương (yêu cầu của kernel DPP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="3020" y="3070" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-dpp" value="&lt;b&gt;S2 greedy MAP-DPP&lt;/b&gt; (PP1)&lt;br&gt;L = diag(q̂)·cos(v,v)·diag(q̂)&lt;br&gt;chọn K = ⌈r·N⌉ chỉ số I_keep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="3520" y="3070" width="420" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-fold" value="&lt;b&gt;S3 assign + S4 fold&lt;/b&gt; (PP1)&lt;br&gt;token bị bỏ gộp vào DeepStack′ của token giữ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="4040" y="3070" width="420" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-llm" value="&lt;b&gt;Qwen3 LLM 28 lớp&lt;/b&gt; (đóng băng)&lt;br&gt;K token ảnh, M-RoPE gốc (gather),&lt;br&gt;DeepStack′ cộng ở lớp 0/1/2 → greedy decode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="4560" y="3070" width="440" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-ans" value="&lt;b&gt;Câu trả lời&lt;/b&gt; (≤ 32 token)&lt;br&gt;+ log K, N, keep_indices, timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="5100" y="3070" width="380" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pp3-e-pca-pp3-e-enc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-pca" target="pp3-e-enc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pp3-e-enc-pp3-e-cat" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-enc" target="pp3-e-cat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pp3-e-cat-pp3-e-mlp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-cat" target="pp3-e-mlp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pp3-e-mlp-pp3-e-q" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-mlp" target="pp3-e-q">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pp3-e-q-pp3-e-dpp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-q" target="pp3-e-dpp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pp3-e-dpp-pp3-e-fold" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-dpp" target="pp3-e-fold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pp3-e-fold-pp3-e-llm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-fold" target="pp3-e-llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pp3-e-llm-pp3-e-ans" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-llm" target="pp3-e-ans">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pp3-e-in-v-pca" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-in-v" target="pp3-e-pca">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pp3-e-in-f-pca" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-in-f" target="pp3-e-pca">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pp3-e-in-q-pca" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-in-q" target="pp3-e-pca">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-z-enc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-in-z" target="pp3-e-enc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-g-pos" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-in-g" target="pp3-e-pos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-pos-enc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-e-pos" target="pp3-e-enc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-shapes" value="&lt;b&gt;Kích thước tensor theo luồng&lt;/b&gt; (1 ảnh, N token, K giữ lại)&lt;br&gt;v [N,2048] → PCA [N,256] → P_v [N,256]&lt;br&gt;f₁..₃ [N,2048] → PCA [N,64] ×3 → P_ℓ [N,64] ×3&lt;br&gt;q [N_q,2048] → PCA [N_q,256] → mean → x_q [256]&lt;br&gt;u [N,467] → h [N,979] → MLP → s [N] → q̂ [N]&lt;br&gt;DPP → I_keep [K] → v[I_keep] [K,2048], DeepStack′ 3×[K,2048]&lt;br&gt;LLM input: N_text + K vị trí (thay vì N_text + N)" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=2;dashed=1;fontColor=#000000;align=left;spacingLeft=8;verticalAlign=top;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="2000" y="3340" width="1420" height="270" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-cost" value="&lt;b&gt;Tham số &amp;amp; chi phí&lt;/b&gt;&lt;br&gt;• Score head 3a ≈ &lt;b&gt;0.78 M&lt;/b&gt; tham số (checkpoint 3.1 MB):&lt;br&gt;  encoder ≈ 0.14 M, MLP ≈ 0.63 M&lt;br&gt;• Selector GQA L3: 38 ms (PP1-D: 34 ms) → +≈4 ms&lt;br&gt;• ViT không đổi; LLM prefill + KV cache ∝ N_text + K&lt;br&gt;• Checkpoint: outputs/pp3_scorer/checkpoints/score_head_3a_seed0.pt&lt;br&gt;• Code: src/token_reduction_vl/pruning/pp3_scorer/{models,features,pruner}.py" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=2;dashed=1;fontColor=#000000;align=left;spacingLeft=8;verticalAlign=top;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="3520" y="3340" width="1480" height="270" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-variants" value="&lt;b&gt;Các biến thể đã thử&lt;/b&gt; (cùng đầu vào u_i, x_q)&lt;br&gt;• &lt;b&gt;3a MLP&lt;/b&gt; — ✔ được chọn&lt;br&gt;• 3b CNN 3×3 ×3 trên lưới H′×W′ + FiLM(x_q) — overfit sau 2 epoch&lt;br&gt;• 3c 1 block self-attn + cross-attn tới q — recall ngang 3a, accuracy L3 thấp hơn 1.2 điểm&lt;br&gt;&lt;i&gt;Giả thuyết: DPP (S2) đã lo phần đa dạng/ngữ cảnh,&lt;br&gt;score head chỉ cần chấm độ liên quan từng token.&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=2;dashed=1;fontColor=#000000;align=left;spacingLeft=8;verticalAlign=top;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="5100" y="3220" width="2240" height="270" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-io" value="&lt;b&gt;Hợp đồng giữ nguyên&lt;/b&gt;: r = 1 (L7) + NoOp ⇒ trùng baseline 300/300; 4 bản DSFold cho cùng keep_indices trên 100 fixture (conformance test)." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=2;dashed=1;fontColor=#000000;align=left;spacingLeft=8;verticalAlign=top;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="5100" y="3520" width="2240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pp3-e-from-s1" value="chi tiết S1 (PP3)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;dashed=1;fontSize=14;fontColor=#6A1B9A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dsf-score" target="pp3-panel-e">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-panel-f" value="F. PP3 — HUẤN LUYỆN SCORE HEAD (ROUTE B, OFFLINE, MỘT LẦN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F0FA;strokeColor=#6A1B9A;strokeWidth=4;dashed=1;fontSize=22;fontStyle=1;verticalAlign=top;fontColor=#6A1B9A;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="360" y="3880" width="7020" height="560" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-data" value="&lt;b&gt;① Dữ liệu&lt;/b&gt;&lt;br&gt;GQA train balanced&lt;br&gt;50 000 câu hỏi&lt;br&gt;configs/splits/gqa_train_50k.txt&lt;br&gt;&lt;i&gt;(tách khỏi tune/evaluate)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="3960" width="790" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-teacher" value="&lt;b&gt;② Qwen3-VL đủ token&lt;/b&gt; (đóng băng)&lt;br&gt;greedy → câu trả lời â (≤ 8 token)&lt;br&gt;teacher-forced: log p(â | ảnh, câu hỏi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1270" y="3960" width="790" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-sal" value="&lt;b&gt;③ Nhãn saliency&lt;/b&gt; (gradient × input)&lt;br&gt;sal_i = |⟨∂log p/∂v_i, v_i⟩|&lt;br&gt;  + Σ_ℓ |⟨∂log p/∂fₗ[i], fₗ[i]⟩|&lt;br&gt;&lt;i&gt;chỉ gradient theo input, không cập nhật trọng số&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="2140" y="3960" width="790" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-shard" value="&lt;b&gt;④ Lưu shard&lt;/b&gt;&lt;br&gt;đặc trưng đã PCA (fp16) + z_rel, z_ms + sal&lt;br&gt;102 shard × 500 mẫu ≈ 9 GB&lt;br&gt;data/features/pp3_scorer/&lt;br&gt;0.43 s/mẫu, resume theo id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="3010" y="3960" width="790" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-loss" value="&lt;b&gt;⑤ ListNet loss&lt;/b&gt;&lt;br&gt;P = softmax((sal / mean sal) / T), T = 0.5&lt;br&gt;Q = softmax(s)&lt;br&gt;L = −Σ_i P_i · log Q_i&lt;br&gt;&lt;i&gt;học THỨ HẠNG token&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="3880" y="3960" width="790" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-opt" value="&lt;b&gt;⑥ Tối ưu&lt;/b&gt;&lt;br&gt;AdamW lr 3e-4, wd 1e-2, batch 16&lt;br&gt;cosine, 10 epoch, patience 3&lt;br&gt;mỗi mẫu bốc ngẫu nhiên mức L1–L5 → log r" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="4750" y="3960" width="790" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-val" value="&lt;b&gt;⑦ Early stop&lt;/b&gt; trên 10% ẢNH giữ lại&lt;br&gt;(không ảnh nào ở cả 2 phía)&lt;br&gt;chọn epoch có ListNet thấp nhất&lt;br&gt;3a: epoch 6, ListNet 3.539" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="5620" y="3960" width="790" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-ckpt" value="&lt;b&gt;⑧ Checkpoint&lt;/b&gt;&lt;br&gt;score_head_3a_seed0.pt&lt;br&gt;→ nạp vào ScoredDSFoldPruner&lt;br&gt;(panel E) khi chạy run_pruned.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=14;fontColor=#000000;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="6490" y="3960" width="790" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-pp3-f-data-pp3-f-teacher" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-f-data" target="pp3-f-teacher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-pp3-f-teacher-pp3-f-sal" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-f-teacher" target="pp3-f-sal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-pp3-f-sal-pp3-f-shard" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-f-sal" target="pp3-f-shard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-pp3-f-shard-pp3-f-loss" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-f-shard" target="pp3-f-loss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp3-f-pp3-f-loss-pp3-f-opt" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="pp3-f-loss" target="pp3-f-opt">
