        <mxCell id="bGAilfCWtUQ7A0YQxOPz-82" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontColor=#000000;labelBackgroundColor=none;" value="xℓ+1&#10;[B,N,2048]&#10;N unchanged" vertex="1">
