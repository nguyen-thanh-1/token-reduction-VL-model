        <mxCell id="bGAilfCWtUQ7A0YQxOPz-83" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;align=left;spacingLeft=12;fontColor=#000000;labelBackgroundColor=none;" value="&lt;b&gt;One decoder for both modalities&lt;/b&gt;&#10;After fusion, text and image vectors occupy positions in the same sequence. The decoder does not contain a separate image-only branch; causal self-attention mixes information over all allowed previous positions." vertex="1">
          <mxGeometry height="165" width="575" x="6755.0" y="1824" as="geometry" />
        </mxCell>
        <mxCell id="bGAilfCWtUQ7A0YQxOPz-84" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7B7B7;fontSize=13;align=left;spacingLeft=12;fontColor=#000000;labelBackgroundColor=none;" value="Residual path 1 bypasses attention; residual path 2 bypasses the MLP. Both preserve [B,N,2048]. DeepStack additions occur only after complete decoder layers 0, 1, and 2—not inside the attention or MLP sublayers." vertex="1">
          <mxGeometry height="135" width="1580" x="3930.0" y="2049" as="geometry" />
        </mxCell>
        <mxCell id="bGAilfCWtUQ7A0YQxOPz-85" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E8FB;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=12;fontColor=#000000;labelBackgroundColor=none;" value="&lt;b&gt;KV-cache dimensions per layer&lt;/b&gt;&#10;K and V cache shape: [B,8,Ncached,128]. Visual and prompt tokens are cached during prefill; each decode step computes Q/K/V only for the newly appended text token." vertex="1">
          <mxGeometry height="135" width="850" x="5550.0" y="2049" as="geometry" />
        </mxCell>
        <mxCell id="bGAilfCWtUQ7A0YQxOPz-86" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;spacingLeft=12;fontColor=#000000;labelBackgroundColor=none;" value="&lt;b&gt;Future experimental hook points&lt;/b&gt;&#10;Candidate interventions may operate on visual embeddings before fusion or on selected decoder stages. Every experiment must state token budget, layer, scoring signal, and spatial safeguard; this diagram itself remains the unpruned reference." vertex="1">
          <mxGeometry height="135" width="890" x="6440.0" y="2049" as="geometry" />
