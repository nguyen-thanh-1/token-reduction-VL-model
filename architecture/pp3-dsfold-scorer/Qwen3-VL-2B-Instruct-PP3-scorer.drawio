        <mxCell id="54MJdHQhc6L-qSlCafsP-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;labelBackgroundColor=none;" value="&lt;div style=&quot;&quot;&gt;&lt;sup&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;Text-side Output&lt;/font&gt;&lt;/b&gt;&lt;/sup&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;- Input_ids [B, N_total]: dãy token ID của toàn chuỗi&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;- attention_mask [B, N_total]:&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#09;&lt;/span&gt;+ 1 = token hoặc vị trí hợp lệ&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#09;&lt;/span&gt;+ 0 = padding cần được model bỏ qua&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;- mm_token_type_ids [B, N_total]&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#09;&lt;/span&gt;+ 0 = text hoặc special token&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#09;&lt;/span&gt;+ 1 = image token (&amp;lt;image_pad&amp;gt;)&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#09;&lt;/span&gt;+ 2 = video token (nhưng mình dùng ảnh nên không có cái này)&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;(B = số mẫu trong batch | N_total =&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center;&quot;&gt;text/special tokens + Nvisual + padding&lt;/span&gt;&lt;/div&gt;" vertex="1">
