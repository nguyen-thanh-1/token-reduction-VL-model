        </mxCell>
        <mxCell id="bGAilfCWtUQ7A0YQxOPz-91" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontColor=#000000;labelBackgroundColor=none;" value="&lt;b&gt;④ Fused multimodal sequence&lt;/b&gt;&#10;Nvisual placeholder vectors replaced in-place&#10;[B,Ntotal,2048]&#10;Ntotal=Ntext_and_special+Nvisual" vertex="1">
