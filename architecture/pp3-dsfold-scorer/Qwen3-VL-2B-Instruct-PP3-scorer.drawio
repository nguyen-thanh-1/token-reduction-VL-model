        <mxCell id="bGAilfCWtUQ7A0YQxOPz-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#B20000;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;strokeWidth=4;" value="Main visual embeddings&lt;br&gt;[N_visual, 2048]&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-weight: normal;&quot;&gt;- Output chính của 24 block&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;- Mỗi token có hidden size 2048&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;- Đặt vào N_visual vị trí &lt;/span&gt;&amp;lt;image_pad&amp;gt;&lt;span style=&quot;font-weight: normal;&quot;&gt; trong chuỗi đầu vào của language model&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="220" x="2470" y="1334" as="geometry" />
