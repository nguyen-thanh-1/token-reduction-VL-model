        <mxCell id="bGAilfCWtUQ7A0YQxOPz-93" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=13;fontColor=#000000;labelBackgroundColor=none;" value="&lt;b&gt;⑥ Autoregressive text output&lt;/b&gt;&#10;step s input length = Ntotal+s&#10;one new text token per step&#10;answer ≤32 generated tokens" vertex="1">
          <mxGeometry height="125" width="970" x="5250" y="2409" as="geometry" />
